---
import { NAV_LINKS } from '@/site.config.ts';

import ThemeToggle from './theme-toggle.astro';
import NavLink from './ui/nav-link.astro';

const currentPath = Astro.url.pathname;
---

<header
  class='top-0 z-50 border-b bg-background/90 backdrop-blur-md supports-backdrop-filter:bg-background/90'
>
  <div class='mx-auto flex h-16 max-w-3xl items-center justify-between gap-4 px-6 py-4'>
    <a href='/' class='text-lg font-medium'>javalce</a>
    <nav class='flex items-center gap-5'>
      {
        NAV_LINKS.map(({ href, label }) => (
          <NavLink
            href={href}
            label={label}
            active={currentPath === href || currentPath.startsWith(`${href}/`)}
          />
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
