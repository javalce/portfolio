---
import type { HTMLAttributes } from 'astro/types';

import AngularIcon from '@/components/icons/angular-icon.astro';
import AstroIcon from '@/components/icons/astro-icon.astro';
import BashIcon from '@/components/icons/bash-icon.astro';
import CssIcon from '@/components/icons/css-icon.astro';
import DockerIcon from '@/components/icons/docker-icon.astro';
import FastapiIcon from '@/components/icons/fastapi-icon.astro';
import GitIcon from '@/components/icons/git-icon.astro';
import GithubDarkIcon from '@/components/icons/github-dark-icon.astro';
import HtmlIcon from '@/components/icons/html-icon.astro';
import JavascriptIcon from '@/components/icons/javascript-icon.astro';
import MongodbIcon from '@/components/icons/mongodb-icon.astro';
import MysqlIcon from '@/components/icons/mysql-icon.astro';
import NextjsIcon from '@/components/icons/nextjs-icon.astro';
import PostgresqlIcon from '@/components/icons/postgresql-icon.astro';
import PythonIcon from '@/components/icons/python-icon.astro';
import ReactIcon from '@/components/icons/react-icon.astro';
import TailwindIcon from '@/components/icons/tailwind-icon.astro';
import TypescriptIcon from '@/components/icons/typescript-icon.astro';
import { BentoCard } from '@/components/ui/bento-card';

interface Props extends Pick<HTMLAttributes<'div'>, 'class'> {}

const { class: className } = Astro.props;

const technologies = [
  { icon: BashIcon, name: 'Bash' },
  { icon: HtmlIcon, name: 'HTML' },
  { icon: CssIcon, name: 'CSS' },
  { icon: JavascriptIcon, name: 'JavaScript' },
  { icon: TypescriptIcon, name: 'TypeScript' },
  { icon: PythonIcon, name: 'Python' },
  { icon: MysqlIcon, name: 'SQL' },
  { icon: TailwindIcon, name: 'Tailwind CSS' },
  { icon: ReactIcon, name: 'React' },
  { icon: NextjsIcon, name: 'Next.js' },
  { icon: AstroIcon, name: 'Astro' },
  { icon: AngularIcon, name: 'Angular' },
  { icon: FastapiIcon, name: 'FastAPI' },
  { icon: MysqlIcon, name: 'MySQL' },
  { icon: PostgresqlIcon, name: 'PostgreSQL' },
  { icon: MongodbIcon, name: 'MongoDB' },
  { icon: GitIcon, name: 'Git' },
  { icon: GithubDarkIcon, name: 'GitHub' },
  { icon: DockerIcon, name: 'Docker' },
];
---

<BentoCard class:list={['overflow-clip', className]}>
  <div
    class='mask-[linear-gradient(to_right,rgba(0,0,0,0)_0%,rgba(0,0,0,1)_10%,rgba(0,0,0,1)_90%,rgba(0,0,0,0)_100%)]'
  >
    <div class='flex h-16 w-max animate-[scroll_40s_linear_infinite] gap-4'>
      {
        technologies.concat(technologies).map(({ icon: Icon, name }) => (
          <div class='group inline-flex items-center gap-2 px-4 py-2 transition-transform duration-300 ease-in-out select-none'>
            <Icon class='isolate size-6 text-transparent group-hover:scale-130' />
            <span class='text-lg font-medium text-primary'>{name}</span>
          </div>
        ))
      }
    </div>
  </div>
</BentoCard>
